{
  "info": {
    "name": "lab05",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1. Идэвхтэй оюутан урьдачаа хангасан үед амжилттай бүртгүүлнэ (OK)",
      "item": [
        {
          "name": "setup student",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/students/S1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "S1"
              ]
            }
          }
        },
        {
          "name": "setup course",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/courses/C1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "C1"
              ]
            }
          }
        },
        {
          "name": "register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"result нь OK\", function () {",
                  "    pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});",
                  "pm.test(\"registrationID нь тоо\", function () {",
                  "    pm.expect(pm.response.json().registrationID).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"S1\",\"courseID\":\"C1\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            }
          }
        }
      ]
    },
